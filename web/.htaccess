# Fuer Apache-Webspace (bei den meisten Hostern Standard). Zum Zusammenfuehren mit
# einer vorhandenen .htaccess einfach diese Zeilen anhaengen.
AddType application/manifest+json .webmanifest
AddType application/javascript .js
AddType application/json .json

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml application/manifest+json
</IfModule>

# Testseite nicht oeffentlich anbieten
<Files "tests.html">
  Require all denied
</Files>

# Spieldateien bei jedem Aufruf kurz pruefen lassen (304, wenn unveraendert),
# damit nach einem Update nie alte und neue Dateien gemischt werden.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js|css|json|webmanifest|php)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
